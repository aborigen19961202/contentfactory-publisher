# ==========================================
# ContentFactory Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://contentfactory_publisher:PASSWORD@127.0.0.1:5432/yeap_stats

# ==========================================
# Google / YouTube Data API v3 OAuth2
# ==========================================
YOUTUBE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_TOKEN_PATH=.tokens/youtube.json

# Default upload settings
YOUTUBE_DEFAULT_PRIVACY=unlisted # 'private', 'unlisted', or 'public'
YOUTUBE_DEFAULT_CATEGORY_ID=27   # 27 = Education, 28 = Science & Technology

# ==========================================
# Telegram Notifications (Bot API)
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
